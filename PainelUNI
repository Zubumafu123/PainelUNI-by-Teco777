	local function updateColors()

		local arms =
			workspace.Camera:FindFirstChild("Arms")

		if not arms then
			return
		end

		for _, v in pairs(
			arms:GetDescendants()
		) do

			if v:IsA("MeshPart") then

				v.Color =
					Color3.fromHSV(
						c2,
						1,
						1
					)
			end
		end
	end

	RunService.RenderStepped:Connect(function()

		if rainbow2 then

			c2 =
				c2 + hueIncrement

			if c2 >= 1 then
				c2 =
					c2 % 1
			end

			updateColors()
		end
	end)

	SectionSkins:NewButton(
		"Resetar Gun Skin",
		"Volta ao padrão",
		function()

			gunColor =
				Color3.fromRGB(
					163,
					162,
					165
				)

			gunMaterial =
				"Plastic"

			local arms =
				workspace.Camera:FindFirstChild("Arms")

			if arms then

				for _, v in pairs(
					arms:GetDescendants()
				) do

					if v:IsA("MeshPart") then

						v.Material =
							Enum.Material.Plastic

						v.Color =
							gunColor
					end
				end
			end
		end
	)

