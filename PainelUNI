local R15_SKELETON = {

	{"Head","UpperTorso"},
	{"UpperTorso","LowerTorso"},

	{"UpperTorso","LeftUpperArm"},
	{"LeftUpperArm","LeftLowerArm"},
	{"LeftLowerArm","LeftHand"},

	{"UpperTorso","RightUpperArm"},
	{"RightUpperArm","RightLowerArm"},
	{"RightLowerArm","RightHand"},

	{"LowerTorso","LeftUpperLeg"},
	{"LeftUpperLeg","LeftLowerLeg"},
	{"LeftLowerLeg","LeftFoot"},

	{"LowerTorso","RightUpperLeg"},
	{"RightUpperLeg","RightLowerLeg"},
	{"RightLowerLeg","RightFoot"}
}

-- =========================================================
-- R6 SKELETON
-- =========================================================

local R6_SKELETON = {

	{"Head","Torso"},

	{"Torso","LeftArmTop"},
	{"LeftArmTop","LeftArmBottom"},

	{"Torso","RightArmTop"},
	{"RightArmTop","RightArmBottom"},

	{"Torso","LeftLegTop"},
	{"LeftLegTop","LeftLegBottom"},

	{"Torso","RightLegTop"},
	{"RightLegTop","RightLegBottom"}
}

local function getSkeletonType(character)

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if humanoid then

		if humanoid.RigType ==
			Enum.HumanoidRigType.R15 then

			return "R15"
		end

		if humanoid.RigType ==
			Enum.HumanoidRigType.R6 then

			return "R6"
		end
	end

	if character:FindFirstChild("UpperTorso") then
		return "R15"
	end

	return "R6"
end

local function getR6Point(character, pointName)

	local part

	if pointName == "LeftArmTop"
		or pointName == "LeftArmBottom" then

		part = character:FindFirstChild("Left Arm")

	elseif pointName == "RightArmTop"
		or pointName == "RightArmBottom" then

		part = character:FindFirstChild("Right Arm")

	elseif pointName == "LeftLegTop"
		or pointName == "LeftLegBottom" then

		part = character:FindFirstChild("Left Leg")

	elseif pointName == "RightLegTop"
		or pointName == "RightLegBottom" then

		part = character:FindFirstChild("Right Leg")
	end

	if not part then
		return nil
	end

	if pointName == "LeftArmTop"
		or pointName == "RightArmTop"
		or pointName == "LeftLegTop"
		or pointName == "RightLegTop" then

		return part.CFrame *
			Vector3.new(
				0,
				part.Size.Y / 2,
				0
			)
	end

	if pointName == "LeftArmBottom"
		or pointName == "RightArmBottom"
		or pointName == "LeftLegBottom"
		or pointName == "RightLegBottom" then

		return part.CFrame *
			Vector3.new(
				0,
				-part.Size.Y / 2,
				0
			)
	end

	return nil
end

local function getPartPosition(character, partName)

	if string.find(partName, "Arm")
		or string.find(partName, "Leg") then

		local special =
			getR6Point(
				character,
				partName
			)

		if special then
			return special
		end
	end

	local part =
		character:FindFirstChild(partName)

	if part then
		return part.Position
	end

	return nil
end

local function hideSkeleton(lines)

	for _, line in pairs(lines) do
		line.Visible = false
	end
end

-- =========================================================
-- CREATE ESP
-- =========================================================

local function createESP(plr)

	local NameTag =
		Drawing.new("Text")

	NameTag.Size = 13
	NameTag.Center = true
	NameTag.Outline = true
	NameTag.Font = 2
	NameTag.Color = espCustomColor
	NameTag.Visible = false

	local Box =
		Drawing.new("Square")

	Box.Thickness = 1
	Box.Filled = false
	Box.Color = espCustomColor
	Box.Visible = false

	local Line =
		Drawing.new("Line")

	Line.Thickness = 1
	Line.Color = espCustomColor
	Line.Visible = false

	local SkeletonLines = {}

	for i = 1,14 do

		local SkeletonLine =
			Drawing.new("Line")

		SkeletonLine.Thickness = 2
		SkeletonLine.Transparency = 1
		SkeletonLine.Color = espCustomColor
		SkeletonLine.Visible = false

		SkeletonLines[i] =
			SkeletonLine
	end

	espBoxes[plr] = {
		Name = NameTag,
		Box = Box,
		Line = Line,
		Skeleton = SkeletonLines
	}

	local connection

	connection =
		RunService.RenderStepped:Connect(function()

			local character =
				plr.Character

			-- =================================================
			-- LOCAL PLAYER
			-- =================================================

			if plr == LocalPlayer
				and not espLocalPlayer then

				NameTag.Visible = false
				Box.Visible = false
				Line.Visible = false

				hideSkeleton(
					SkeletonLines
				)

				return
			end

			-- =================================================
			-- CHARACTER
			-- =================================================

			if not character then

				NameTag.Visible = false
				Box.Visible = false
				Line.Visible = false

				hideSkeleton(
					SkeletonLines
				)

				return
			end

			local hrp =
				character:FindFirstChild(
					"HumanoidRootPart"
				)

			local head =
				character:FindFirstChild(
					"Head"
				)

			local humanoid =
				character:FindFirstChildOfClass(
					"Humanoid"
				)

			if not hrp
				or not head
				or not humanoid then

				NameTag.Visible = false
				Box.Visible = false
				Line.Visible = false

				hideSkeleton(
					SkeletonLines
				)

				return
			end

			if humanoid.Health <= 0 then

				NameTag.Visible = false
				Box.Visible = false
				Line.Visible = false

				hideSkeleton(
					SkeletonLines
				)

				return
			end

			local pos, visible =
				Camera:WorldToViewportPoint(
					hrp.Position
				)

			if not visible then

				NameTag.Visible = false
				Box.Visible = false
				Line.Visible = false

				hideSkeleton(
					SkeletonLines
				)

				return
			end

			local espColor

			if espTeamColor then
				espColor =
					getTeamColor(plr)
			else
				espColor =
					espCustomColor
			end

			-- =================================================
			-- NAME
			-- SÓ APARECE COM ENABLE ESP + ESP NAME
			-- =================================================

			if espEnabled and espNameEnabled then

				local headPos =
					Camera:WorldToViewportPoint(
						head.Position +
						Vector3.new(0,0.5,0)
					)

				NameTag.Position =
					Vector2.new(
						pos.X,
						headPos.Y - 15
					)

				NameTag.Text =
					plr.Name

				NameTag.Color =
					espColor

				NameTag.Visible =
					true

			else

				NameTag.Visible =
					false
			end

			-- =================================================
			-- ESP DESLIGADO
			-- =================================================

			if not espEnabled then

				Box.Visible = false
				Line.Visible = false

				hideSkeleton(
					SkeletonLines
				)

				return
			end

			-- =================================================
			-- BOX
			-- =================================================

			if espBoxEnabled then

				local headPos =
					Camera:WorldToViewportPoint(
						head.Position +
						Vector3.new(0,0.5,0)
					)

				local feetPos =
					Camera:WorldToViewportPoint(
						hrp.Position -
						Vector3.new(0,3,0)
					)

				local height =
					math.abs(
						headPos.Y -
						feetPos.Y
					)

				local width =
					height / 2

				Box.Size =
					Vector2.new(
						width,
						height
					)

				Box.Position =
					Vector2.new(
						pos.X - width / 2,
						headPos.Y
					)

				Box.Color =
					espColor

				Box.Visible =
					true

			else

				Box.Visible =
					false
			end

			-- =================================================
			-- LINE
			-- =================================================

			if espLineEnabled then

				local feetPos =
					Camera:WorldToViewportPoint(
						hrp.Position -
						Vector3.new(0,3,0)
					)

				Line.From =
					Vector2.new(
						Camera.ViewportSize.X / 2,
						Camera.ViewportSize.Y
					)

				Line.To =
					Vector2.new(
						pos.X,
						feetPos.Y
					)

				Line.Color =
					espColor

				Line.Visible =
					true

			else

				Line.Visible =
					false
			end

			-- =================================================
			-- SKELETON
			-- =================================================

			if espSkeletonEnabled then

				local skeletonType =
					getSkeletonType(
						character
					)

				local connections

				if skeletonType == "R15" then
					connections =
						R15_SKELETON
				else
					connections =
						R6_SKELETON
				end

				for i = 1,#SkeletonLines do

					local skeletonLine =
						SkeletonLines[i]

					local data =
						connections[i]

					if data then

						local pos1 =
							getPartPosition(
								character,
								data[1]
							)

						local pos2 =
							getPartPosition(
								character,
								data[2]
							)

						if pos1 and pos2 then

							local screen1, vis1 =
								Camera:WorldToViewportPoint(
									pos1
								)

							local screen2, vis2 =
								Camera:WorldToViewportPoint(
									pos2
								)

							if vis1 and vis2 then

								skeletonLine.From =
									Vector2.new(
										screen1.X,
										screen1.Y
									)

								skeletonLine.To =
									Vector2.new(
										screen2.X,
										screen2.Y
									)

								skeletonLine.Color =
									espColor

								skeletonLine.Visible =
									true

							else

								skeletonLine.Visible =
									false
							end

						else

							skeletonLine.Visible =
								false
						end

					else

						skeletonLine.Visible =
							false
					end
				end

			else

				hideSkeleton(
					SkeletonLines
				)
			end
		end)

	-- =================================================
	-- CLEANUP
	-- =================================================

	plr.AncestryChanged:Connect(
		function(_, parent)

			if not parent then

				if connection then
					connection:Disconnect()
				end

				NameTag:Remove()
				Box:Remove()
				Line:Remove()

				for _, skeletonLine in pairs(
					SkeletonLines
				) do

					skeletonLine:Remove()
				end

				espBoxes[plr] =
					nil
			end
		end
	)
end

